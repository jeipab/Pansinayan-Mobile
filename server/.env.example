# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false
LOG_LEVEL=info

# Model Paths (relative to server directory)
TRANSFORMER_MODEL_PATH=SignTransformerCtc_best.pt
GRU_MODEL_PATH=MediaPipeGRUCtc_best.pt
MODELS_DIR=.

# Device Configuration
DEVICE=cuda

# Model Hyperparameters (must match training)
INPUT_DIM=178
NUM_CTC_CLASSES=106
NUM_CAT=10

# Transformer Config
TRANSFORMER_EMB_DIM=512
TRANSFORMER_N_HEADS=8
TRANSFORMER_N_LAYERS=6
TRANSFORMER_DROPOUT=0.05
TRANSFORMER_FF_DIM=2048

# GRU Config
GRU_HIDDEN1=512
GRU_HIDDEN2=512
GRU_DROPOUT=0.3

# Performance Settings
MAX_SEQUENCE_LENGTH=300
BATCH_SIZE=1

# CORS (separate multiple origins with commas)
CORS_ORIGINS=*